{
  "name": "@experts21/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Talk to the DIO expert team in a browser: a React front end with Netlify Functions that call the Claude API.",
  "scripts": {
    "build": "node scripts/build-agents.mjs && tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "vite --host 127.0.0.1",
    "serve": "node scripts/serve.mjs",
    "test": "node scripts/test-functions.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "lucide-react": "0.468.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@netlify/functions": "6.1.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
